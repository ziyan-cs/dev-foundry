{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go: Test",
      "type": "shell",
      "command": "go",
      "args": ["test", "-race", "./..."],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Go: Build",
      "type": "shell",
      "command": "go",
      "args": ["build", "./cmd/app"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Go: Check",
      "type": "shell",
      "command": "go",
      "args": ["vet", "./..."],
      "dependsOn": "Go: Test",
      "dependsOrder": "sequence",
      "problemMatcher": ["$go"]
    }
  ]
}
